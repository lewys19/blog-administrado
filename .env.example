# Copia este archivo como .env y completa los valores. El .env no se sube a git.
DB_PASSWORD=
# Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Dirección pública del blog (va en los enlaces de los correos)
SITIO_URL=http://localhost:3300
# Correo saliente del boletín. Vacío = los correos se guardan en backend/buzon/ sin enviarse.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_SEGURIDAD=starttls
CORREO_REMITENTE=zcorp-stack <no-responder@localhost>

# IA (Sprint 5): clave de https://platform.claude.com → API keys. Vacía = el botón «Generar con IA» avisa.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
IA_ESFUERZO=medium
