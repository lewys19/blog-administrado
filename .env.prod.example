# .env del blog en el servidor. Cópialo como ~/blog/.env en el VPS, complétalo y protégelo:
#   chmod 600 .env
# Nunca se sube a GitHub.

# Obligatorios. Genera cada uno en el VPS con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DB_PASSWORD=

# Dirección pública, sin / al final. Debe coincidir con el bloque del proxy (Caddyfile)
# y con la variable SITIO_URL del repositorio en GitHub (la usa la web al compilar).
SITIO_URL=https://blog.zcorp23.com

# Procesos de la API: 2 a 4 según los núcleos del VPS.
UVICORN_WORKERS=2

# Versión a usar: latest o el hash de un commit de main (para volver atrás).
VERSION=latest

# Correo del boletín (SMTP). Vacío = los correos no salen (quedan guardados dentro del volumen de fotos).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_SEGURIDAD=starttls
CORREO_REMITENTE=zcorp-stack <boletin@zcorp23.com>

# IA (Sprint 5): clave de https://platform.claude.com → API keys. Vacía = el botón «Generar con IA» avisa.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
IA_ESFUERZO=medium

# Academia: número de WhatsApp para las compras, con código de país y sin + (por ejemplo 51999002030).
WHATSAPP_ACADEMIA=
